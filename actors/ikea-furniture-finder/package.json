{
    "name": "ikea-furniture-finder",
    "version": "0.0.1",
    "type": "module",
    "description": "Finds the IKEA product that best matches a furniture description and returns its image.",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "axios": "^1.5.0",
        "cheerio": "^1.0.0-rc.12",
        "crawlee": "^3.13.0",
        "playwright": "^1.49.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^5.0.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "author": "It's not you it's me",
    "license": "ISC"
}
