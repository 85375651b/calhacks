RENTCAST_API_KEY=your_key_here
USE_FIXTURES=true
PORT=3001
APIFY_TOKEN=your_token_here
ENABLE_APIFY=true

APIFY_MAX_RUNS_PER_HOUR=60

# Optional furniture extraction (server only)
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_CALLS_PER_HOUR=30
# Opt-in single-page fallback; shares the global Apify run cap
ENABLE_FURNITURE_APIFY=false
# IKEA description search uses this actor through the existing APIFY_TOKEN.
# USE_FIXTURES=true returns a labeled recorded result without running the actor.
IKEA_ACTOR_ID=1s1g2xDQFnPD0zt6C
IKEA_MAX_RUNS_PER_HOUR=10

# Describe it: per-source candidate and per-batch commute limits (hard caps 50 / 12)
COMMUTE_SEARCH_LIMIT=30
COMMUTE_VERIFY_LIMIT=8

# Optional floor plan lookup settings (uses the existing APIFY_TOKEN)
FLOORPLAN_ACTOR_ID=t26CMdjfnjh3OcJYT
FLOORPLAN_RUN_TIMEOUT_SECS=150
FLOORPLAN_MAX_RUNS_PER_HOUR=20
FLOORPLAN_CLIENT_RUNS_PER_HOUR=5

# Optional CPU image-to-3D converter. The ignored server/data/cubicasa setup is
# detected automatically. Set these only when reusing an existing installation.
# CUBICASA_DIR=/absolute/path/to/CubiCasa5k
# CUBICASA_WEIGHTS=/absolute/path/to/model_best_val_loss_var.pkl
# CUBICASA_PYTHON=/absolute/path/to/.venv/bin/python
# TESSERACT_CMD=/absolute/path/to/tesseract

# Optional address autocomplete (Photon fallback)
GEOAPIFY_API_KEY=your_key_here
AUTOCOMPLETE_PROVIDER=auto
GEOAPIFY_MAX_REQUESTS_PER_DAY=2500
# Address-only RentCast checks; persisted daily guard
RENTCAST_ADDRESS_MAX_REQUESTS_PER_DAY=100
