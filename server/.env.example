RENTCAST_API_KEY=your_key_here
USE_FIXTURES=true
PORT=3001
APIFY_TOKEN=your_token_here
ENABLE_APIFY=true

APIFY_MAX_RUNS_PER_HOUR=60

# Optional furniture extraction (server only)
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_CALLS_PER_HOUR=30
# Opt-in single-page fallback; shares the global Apify run cap
ENABLE_FURNITURE_APIFY=false

# Describe it: per-source candidate and per-batch commute limits (hard caps 50 / 12)
COMMUTE_SEARCH_LIMIT=30
COMMUTE_VERIFY_LIMIT=8

# Optional floor plan lookup settings (uses the existing APIFY_TOKEN)
FLOORPLAN_ACTOR_ID=t26CMdjfnjh3OcJYT
FLOORPLAN_RUN_TIMEOUT_SECS=150
FLOORPLAN_MAX_RUNS_PER_HOUR=20
FLOORPLAN_CLIENT_RUNS_PER_HOUR=5
