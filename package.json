{
  "name": "propertylens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "start:server": "node server/index.js",
    "inspect:rentcast": "node server/scripts/inspect-rentcast.js",
    "test": "node --test server/tests/*.test.js",
    "check:secrets": "node server/scripts/check-secrets.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "three": "^0.186.1",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^7.1.12"
  }
}
